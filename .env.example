# Public site URL (no trailing slash). Used for metadata, sitemap, and JSON-LD.
# Production: https://saifcore.tech
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact email — CTA mailto + Resend “to” address (required for the form).
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Profile / schema.org — public name and location.
# NEXT_PUBLIC_PROFILE_NAME=Your Name
# NEXT_PUBLIC_PROFILE_CITY=Dakar
# NEXT_PUBLIC_PROFILE_COUNTRY=Senegal
# NEXT_PUBLIC_PROFILE_COUNTRY_CODE=SN

# Resume / CV — optional external override; else public/resume-{en,fr}.pdf.
# NEXT_PUBLIC_RESUME_URL=https://example.com/your-cv.pdf

# Optional — footer links and Person schema `sameAs`.
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/yourprofile
# NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername
# NEXT_PUBLIC_X_URL=https://x.com/yourhandle

# SAIFCORE Blog — article index + recent-posts API for home teasers.
# NEXT_PUBLIC_BLOG_URL=https://blog.saifcore.tech

# Resend — contact form (server-only). https://resend.com/api-keys
# Local test without a domain: RESEND_FROM_EMAIL=SAIFCORE <onboarding@resend.dev>
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=SAIFCORE <hello@yourdomain.com>
